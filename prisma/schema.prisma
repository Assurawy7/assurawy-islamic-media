// Assurawy Islamic Media — Database Schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum QuestionType {
  MULTIPLE_CHOICE
  SHORT_ANSWER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         Role     @default(STUDENT)
  bio          String?
  avatarUrl    String?
  image        String?  
  quizScores   Json?    // <--- An kara fagen quizScores anan don gyara kuskuren build
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Gamification
  points         Int       @default(0)
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastActivityAt DateTime?

  // Teacher relations
  coursesTaught Course[]    @relation("TeacherCourses")
  liveClasses   LiveClass[] @relation("TeacherLiveClasses")

  // Student relations
  enrollments           Enrollment[]
  quizAttempts          QuizAttempt[]
  certificates          Certificate[]
  lessonProgress        LessonProgress[]
  memorization          MemorizationEntry[]
  recitations           Recitation[]
  liveAttendances       LiveAttendance[]
  assignmentSubmissions AssignmentSubmission[]

  // Community
  forumPosts    ForumPost[]
  forumComments ForumComment[]
  announcements Announcement[] @relation("AnnouncementAuthor")

  // Finance
  payments Payment[]

  // Badges
  badges UserBadge[]

  // Notifications & Messages
  notifications    Notification[]
  messagesSent     Message[]      @relation("SenderMessages")
  messagesReceived Message[]      @relation("ReceiverMessages")

  // Activity & Reviews
  activityLogs  ActivityLog[]
  courseReviews CourseReview[]

  @@index([role])
}

model Course {
  id           String  @id @default(cuid())
  slug         String  @unique
  title        String
  description  String
  level        String  @default("Foundational")
  thumbnailUrl String?
  published    Boolean @default(false)
  priceKobo    Int     @default(0)

  teacherId String
  teacher   User   @relation("TeacherCourses", fields: [teacherId], references: [id])

  categoryId String?
  category   CourseCategory? @relation(fields: [categoryId], references: [id])

  modules     Module[]
  enrollments Enrollment[]
  payments    Payment[]
  liveClasses LiveClass[]
  reviews     CourseReview[]
  assignments Assignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId])
  @@index([categoryId])
}

model CourseCategory {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  courses Course[]

  createdAt DateTime @default(now())
}

model Module {
  id       String   @id @default(cuid())
  title    String
  order    Int
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  Lesson[]

  @@index([courseId])
}

model Lesson {
  id          String           @id @default(cuid())
  title       String
  order       Int
  videoUrl    String?
  content     String?
  moduleId    String
  module      Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  attachments Attachment[]
  quiz        Quiz?
  progress    LessonProgress[]

  @@index([moduleId])
}

model Attachment {
  id       String @id @default(cuid())
  fileName String
  fileUrl  String
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

model Enrollment {
  id         String   @id @default(cuid())
  studentId  String
  student    User     @relation(fields: [studentId], references: [id])
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id])
  enrolledAt DateTime @default(now())

  @@unique([studentId, courseId])
  @@index([courseId])
}

model LessonProgress {
  id          String   @id @default(cuid())
  studentId   String
  student     User     @relation(fields: [studentId], references: [id])
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id])
  completedAt DateTime @default(now())

  @@unique([studentId, lessonId])
}

model LiveClass {
  id          String   @id @default(cuid())
  title       String
  description String?
  meetingUrl  String
  platform    String   @default("ZOOM")
  scheduledAt DateTime 
  duration    Int      @default(60) 
  status      String   @default("UPCOMING")

  teacherId String
  teacher   User   @relation("TeacherLiveClasses", fields: [teacherId], references: [id])

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  attendances LiveAttendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId])
  @@index([courseId])
}

model LiveAttendance {
  id          String    @id @default(cuid())
  liveClassId String
  liveClass   LiveClass @relation(fields: [liveClassId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation(fields: [studentId], references: [id])

  joinedAt DateTime  @default(now())
  leftAt   DateTime?
  duration Int       @default(0)

  @@unique([liveClassId, studentId])
  @@index([studentId])
}

model Quiz {
  id           String        @id @default(cuid())
  title        String
  passingScore Int           @default(60)
  lessonId     String        @unique
  lesson       Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions    Question[]
  attempts     QuizAttempt[]
}

model Question {
  id            String       @id @default(cuid())
  quizId        String
  quiz          Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  type          QuestionType
  prompt        String
  options       Json?
  correctAnswer String
  points        Int          @default(1)
  order         Int

  @@index([quizId])
}

model QuizAttempt {
  id          String   @id @default(cuid())
  studentId   String
  student     User     @relation(fields: [studentId], references: [id])
  quizId      String
  quiz        Quiz     @relation(fields: [quizId], references: [id])
  answers     Json
  score       Int
  maxScore    Int
  percentage  Int
  passed      Boolean
  submittedAt DateTime @default(now())

  @@index([studentId, quizId])
}

model Assignment {
  id          String    @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  submissions AssignmentSubmission[]

  createdAt DateTime @default(now())

  @@index([courseId])
}

model AssignmentSubmission {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation(fields: [studentId], references: [id])

  fileUrl     String?
  answer      String?
  score       Int?
  feedback    String?
  submittedAt DateTime @default(now())

  @@unique([assignmentId, studentId])
  @@index([studentId])
}

model Certificate {
  id            String   @id @default(cuid())
  certificateNo String   @unique
  studentId     String
  student       User     @relation(fields: [studentId], references: [id])
  courseTitle   String
  issuedAt      DateTime @default(now())

  @@index([studentId])
}

model MemorizationEntry {
  id         String   @id @default(cuid())
  studentId  String
  student    User     @relation(fields: [studentId], references: [id])
  juzNumber  Int
  percentage Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([studentId, juzNumber])
}

model Recitation {
  id          String   @id @default(cuid())
  studentId   String
  student     User     @relation(fields: [studentId], references: [id])
  audioUrl    String
  surah       String
  ayahRange   String
  feedback    String?
  reviewedBy  String?
  submittedAt DateTime @default(now())

  @@index([studentId])
}

model CourseReview {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation(fields: [studentId], references: [id])
  rating    Int
  review    String?
  createdAt DateTime @default(now())

  @@unique([courseId, studentId])
}

model ForumPost {
  id        String         @id @default(cuid())
  title     String
  body      String
  authorId  String
  author    User           @relation(fields: [authorId], references: [id])
  comments  ForumComment[]
  createdAt DateTime       @default(now())
}

model ForumComment {
  id        String    @id @default(cuid())
  body      String
  postId    String
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  createdAt DateTime  @default(now())

  @@index([postId])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  authorId  String
  author    User     @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  createdAt DateTime @default(now())
}

model Payment {
  id         String        @id @default(cuid())
  reference  String        @unique
  studentId  String
  student    User          @relation(fields: [studentId], references: [id])
  courseId   String
  course     Course        @relation(fields: [courseId], references: [id])
  amountKobo Int
  status     PaymentStatus @default(PENDING)
  paidAt     DateTime?
  createdAt  DateTime      @default(now())

  @@index([studentId])
  @@index([courseId])
}

model Badge {
  id          String      @id @default(cuid())
  code        String      @unique
  name        String
  description String
  icon        String      @default("★")
  users       UserBadge[]
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  badgeId  String
  badge    Badge    @relation(fields: [badgeId], references: [id])
  earnedAt DateTime @default(now())

  @@unique([userId, badgeId])
  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  sender     User     @relation("SenderMessages", fields: [senderId], references: [id])
  receiverId String
  receiver   User     @relation("ReceiverMessages", fields: [receiverId], references: [id])
  message    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([senderId])
  @@index([receiverId])
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  action      String
  description String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([userId])
}

model SiteSettings {
  id                String   @id @default("default")
  siteName          String   @default("Assurawy Islamic Media")
  siteTagline       String   @default("Designing Da'wah with Excellence")
  logoUrl           String   @default("/logo.png")
  faviconUrl        String?
  primaryColor      String   @default("#D4AF37")
  secondaryColor    String   @default("#1B2A4A")
  fontFamily        String   @default("Inter")
  defaultLanguage   String   @default("ha")
  maintenanceMode   Boolean  @default(false)
  allowRegistration Boolean  @default(true)
  updatedAt         DateTime @updatedAt
}